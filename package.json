{
  "name": "platform-survival",
  "version": "0.1.0",
  "private": true,
  "description": "TAILSPIN — a 24-fighter, tail-swinging 3D survival arena.",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@pixi/3d": "0.1.0",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.21.0"
}
